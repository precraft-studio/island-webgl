---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About — Island Phase 0">
  <div data-scroll-root>
    <!-- Second page exists for one reason: proving the WebGL context survives
         navigation. Move between Home and About and watch the scene keep its
         rotation, its light and its wave phase. -->
    <section class="hero" data-cursor="draggable" data-chapter>
      <div>
        <h1 data-reveal data-parallax="1.6">Still the <em>same</em> ocean</h1>
        <p data-reveal data-parallax="1.2">View transitions · persisted canvas</p>
      </div>
      <div class="hero-hint">
        <span>Drag horizontally</span>
        <span>slide <b data-slide-readout>0.00</b></span>
      </div>
    </section>

    <section class="chapter" data-chapter>
      <div class="panel" data-parallax="0.5">
        <div class="eyebrow" data-reveal>Why this page exists</div>
        <h2 data-reveal>No reload, no reset</h2>
        <p data-reveal>
          Navigating here did not rebuild the renderer, recompile a shader or
          re-upload a texture. The canvas node is marked
          <code>transition:persist</code>, so the browser keeps it — and the
          scene continues from exactly where it was.
        </p>
        <p data-reveal>
          That is the mechanism behind the reference site's seamless page
          changes, and it is why the 3D layer must stay decoupled from the DOM
          that swaps around it.
        </p>
      </div>
    </section>

    <footer class="foot">Back to home — the scene will not flinch</footer>
  </div>
</Layout>
