---
import { ClientRouter } from 'astro:transitions';
import SectionNav from '../components/SectionNav.astro';
import '../styles/global.css';

interface Props { title?: string }
const { title = 'Island — Phase 0' } = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Phase 0 technical prototype — island WebGL scroll experience." />
    <title>{title}</title>
    <!-- View Transitions. Paired with transition:persist below, this is what
         lets us navigate without tearing down the WebGL context. -->
    <ClientRouter />
  </head>

  <body>
    <div class="loader" transition:persist="loader"><span>Loading</span></div>

    <!-- transition:persist keeps this exact DOM node (and its live WebGL
         context) across navigations — the single most important line here. -->
    <div id="canvas-wrapper" transition:persist="webgl" aria-hidden="true">
      <canvas data-engine="three.js"></canvas>
    </div>

    <div class="cursor-ring" transition:persist="cursor-ring" aria-hidden="true"></div>

    <header class="site-head">
      <a class="wordmark" href="/">Island</a>
      <SectionNav />
    </header>

    <!-- animate="none" removes Astro's default cross-fade. With a live 3D
         world behind the content, fading the old page out and the new one in
         reads as a flash over the scene rather than as a transition. The
         reference site disables it the same way. -->
    <main class="page" transition:animate="none"><slot /></main>

    <script>
      import { GlobalApp, state, EVENTS } from '../webgl/GlobalApp.js';
      import { initCursor } from '../scripts/cursor.js';
      import { initDrag } from '../scripts/drag.js';
      import { initScroll } from '../scripts/scroll.js';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      let booted = false;

      // A boot failure must never be silent: this runs inside an event
      // listener, so a thrown error would otherwise vanish into an unhandled
      // rejection and leave the loader up with no explanation.
      window.__islandBoot = { scriptRan: true, calls: 0, error: null };

      async function boot() {
        try {
          await bootInner();
        } catch (err) {
          window.__islandBoot.error = String((err && err.stack) || err);
          console.error('[island] boot failed:', err);
        }
      }

      async function bootInner() {
        window.__islandBoot.calls++;
        const wrapper = document.querySelector('#canvas-wrapper');
        const canvas = wrapper?.querySelector('canvas');
        if (!wrapper || !canvas) return;

        // One-time: engine, cursor, resize. These survive navigation because
        // their DOM nodes are persisted.
        if (!booted) {
          await GlobalApp.init(wrapper, canvas);
          state.emit(EVENTS.ATTACH);
          state.emit(EVENTS.RESIZE, GlobalApp.viewportInfo());
          window.addEventListener('resize', () =>
            state.emit(EVENTS.RESIZE, GlobalApp.viewportInfo())
          );
          initCursor();
          booted = true;
        }

        // Per-page: scroll triggers and the drag zone belong to the markup
        // that just swapped in, so they are rebuilt every navigation.
        ScrollTrigger.getAll().forEach((t) => t.kill());
        initDrag();
        initScroll();

        requestAnimationFrame(() => document.body.classList.add('loaded'));
      }

      // The swap replaces <body> and its attributes, so the `loaded` class is
      // lost on every navigation and the loader flashes back to full opacity
      // for one frame. after-swap runs before paint, so re-adding it here is
      // what keeps the transition silent.
      document.addEventListener('astro:after-swap', () =>
        document.body.classList.add('loaded')
      );

      document.addEventListener('astro:page-load', boot);

      // Module scripts are deferred, so on the initial load this one can
      // evaluate AFTER the router has already fired astro:page-load — in which
      // case the listener above never runs and nothing boots. Catch that case.
      // boot() is safe to call twice: the engine guards itself, and the drag
      // and scroll handlers kill their previous instances first.
      if (document.readyState !== 'loading') boot();
    </script>
  </body>
</html>
